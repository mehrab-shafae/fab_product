# .env.example - Environment Variables for asproduct project

# General Application Settings
PORT=5003
NODE_ENV=development # Set to 'production' for production environment
LOG_LEVEL=info # Set to 'debug', 'info', 'warn', 'error'
DEBUG_MODE=false # Set to 'true' to enable debug logs

# PostgreSQL Database Configuration
# You can either provide a full URI or individual components.
# If individual components are provided, they will override parts of POSTGRES_URI if it's also set.
# Example for a full URI (uncomment and modify if you prefer this method):
# POSTGRES_URI="postgresql://user:password@host:port/database_name"

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=product_db

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET=uploads
